  <Capability Min="10" Max="10">10: Fog Back</Capability>
  <Capability Min="11" Max="11">11: Ghost</Capability>
  <Capability Min="12" Max="12">12: Snake</Capability>
  <Capability Min="13" Max="13">13: Fire</Capability>
  <Capability Min="14" Max="14">14: Lightning</Capability>
  <Capability Min="15" Max="15">15: Mouse</Capability>
  <Capability Min="16" Max="16">16: Stars</Capability>
  <Capability Min="17" Max="17">17: Comets</Capability>
  <Capability Min="18" Max="18">18: Aurora</Capability>
  <Capability Min="19" Max="19">19: Rain</Capability>
  <Capability Min="20" Max="20">20: Snowfall</Capability>
  <Capability Min="21" Max="21">21: Fog Mid</Capability>
  <Capability Min="22" Max="22">22: Fog Front</Capability>
  <Capability Min="23" Max="23">23: All 3 Fog Layers</Capability>
  <Capability Min="24" Max="255">FX Loop 1..20</Capability>
 </Channel>
 <Channel Name="Audio Track">
  <Group Byte="0">Maintenance</Group>
  <Capability Min="0" Max="0">None</Capability>
  <Capability Min="1" Max="255">Track 001..255 (.wav/.mp3)</Capability>
 </Channel>
 <Channel Name="Audio Volume">
  <Group Byte="0">Intensity</Group>
  <Capability Min="0" Max="255">0% to 100% (Max 0.65 Gain)</Capability>
 </Channel>
 <Channel Name="Audio Trigger">
  <Group Byte="0">Maintenance</Group>
  <Capability Min="0" Max="127">Stop / Idle</Capability>
  <Capability Min="128" Max="255">Trigger Track Playback</Capability>
 </Channel>
 <Channel Name="Master Dimmer" Preset="IntensityMasterDimmer">
  <Group Byte="0">Intensity</Group>
  <Capability Min="0" Max="0">Full Brightness (100%)</Capability>
  <Capability Min="1" Max="254">Dimming (100% to 1%)</Capability>
  <Capability Min="255" Max="255">Blackout (0%)</Capability>
 </Channel>
